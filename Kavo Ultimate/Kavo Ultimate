                        numericValue = currentValue
                    end

                    numericValue = math.clamp(math.floor(numericValue + 0.5), minvalue, maxvalue)
                    local changed = numericValue ~= currentValue
                    currentValue = numericValue

                    local range = maxvalue - minvalue
                    local percent = range > 0 and ((numericValue - minvalue) / range) or 0
                    local trackWidth = sliderBtn.AbsoluteSize.X
                    if trackWidth <= 0 then
                        trackWidth = 149
                    end

                    sliderDrag.Size = UDim2.new(0, math.floor(percent * trackWidth + 0.5), 1, 0)
