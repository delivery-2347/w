local function getGuiParent()
    -- Executors may expose gethui(); standard client scripts fall back to PlayerGui.
    local ok, hiddenGui = pcall(function()
        return gethui()
    end)
    if ok and hiddenGui then
        return hiddenGui
    end

    local player = Players.LocalPlayer
    if player then
        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            return playerGui
        end
    end

    return CoreGui
end

function Kavo:ToggleUI()
    local gui = self._currentGui
    if gui and gui.Parent then
        gui.Enabled = not gui.Enabled
    end
end

function Kavo:Destroy()
    local gui = self._currentGui
    if gui and gui.Parent then
        gui:Destroy()
    end
    if notificationGui and notificationGui.Parent then
        notificationGui:Destroy()
    end
    notificationGui = nil
    notificationHolder = nil
end

