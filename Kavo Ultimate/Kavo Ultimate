-- Notification API, merged from the notification variants.
function Kavo:Notify(titleText, bodyText, duration)
    local theme = self._theme or themes
    local parent = self._uiParent
    if not parent or not parent.Parent then
        parent = getGuiParent()
    end

    titleText = tostring(titleText or "Notification")
    bodyText = tostring(bodyText or "")
    duration = math.max(0.1, tonumber(duration) or 5)

    if not notificationGui or not notificationGui.Parent then
        notificationGui = Instance.new("ScreenGui")
        notificationGui.Name = "KavoNotifications"
        notificationGui.ResetOnSpawn = false
        notificationGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        notificationGui.Parent = parent

        notificationHolder = Instance.new("Frame")
        notificationHolder.Name = "Holder"
        notificationHolder.AnchorPoint = Vector2.new(1, 0)
        notificationHolder.Position = UDim2.new(1, -14, 0, 14)
        notificationHolder.Size = UDim2.new(0, 300, 1, -28)
        notificationHolder.BackgroundTransparency = 1
        notificationHolder.Parent = notificationGui

        local layout = Instance.new("UIListLayout")
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 8)
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        layout.VerticalAlignment = Enum.VerticalAlignment.Top
        layout.Parent = notificationHolder
    end

    local slot = Instance.new("Frame")
    slot.Name = "NotificationSlot"
    slot.Size = UDim2.new(1, 0, 0, 72)
    slot.BackgroundTransparency = 1
    slot.ClipsDescendants = true
    slot.Parent = notificationHolder

    local card = Instance.new("Frame")
    card.Name = "Notification"
    card.Size = UDim2.new(1, 0, 0, 72)
    card.BackgroundColor3 = theme.ElementColor or Color3.fromRGB(32, 32, 38)
    card.BorderSizePixel = 0
    card.ClipsDescendants = true
    card.Parent = slot

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = card

    local accent = Instance.new("Frame")
    accent.Name = "Accent"
    accent.Size = UDim2.new(0, 3, 1, 0)
    accent.BackgroundColor3 = theme.SchemeColor or Color3.fromRGB(74, 99, 135)
    accent.BorderSizePixel = 0
    accent.Parent = card

    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 12, 0, 8)
    title.Size = UDim2.new(1, -24, 0, 20)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextColor3 = theme.TextColor or Color3.new(1, 1, 1)
    title.TextTruncate = Enum.TextTruncate.AtEnd
    title.Text = titleText
    title.Parent = card

    local message = Instance.new("TextLabel")
    message.Name = "Message"
    message.BackgroundTransparency = 1
    message.Position = UDim2.new(0, 12, 0, 30)
    message.Size = UDim2.new(1, -24, 1, -36)
    message.Font = Enum.Font.Gotham
    message.TextSize = 12
    message.TextWrapped = true
    message.TextXAlignment = Enum.TextXAlignment.Left
    message.TextYAlignment = Enum.TextYAlignment.Top
    message.TextColor3 = theme.TextColor or Color3.new(1, 1, 1)
    message.Text = bodyText
    message.Parent = card

    card.Position = UDim2.new(1, 320, 0, 0)
    tween:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(duration, function()
        if not card.Parent or not slot.Parent then
            return
        end

        local closeTween = tween:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 320, 0, 0),
            BackgroundTransparency = 1
        })
        for _, descendant in ipairs(card:GetDescendants()) do
            if descendant:IsA("TextLabel") then
                tween:Create(descendant, TweenInfo.new(0.2), {TextTransparency = 1}):Play()
            elseif descendant:IsA("Frame") then
                tween:Create(descendant, TweenInfo.new(0.2), {BackgroundTransparency = 1}):Play()
            end
        end
        closeTween:Play()
        closeTween.Completed:Wait()
        if slot.Parent then
            slot:Destroy()
        end
    end)
end

return Kavo
