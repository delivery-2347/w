    function Kavo:ChangeColor(prope, color)
        if themeList[prope] == nil or typeof(color) ~= "Color3" then
            return false
        end
        themeList[prope] = color

        if prope == "Background" then
            Main.BackgroundColor3 = color
            for _, object in ipairs(ScreenGui:GetDescendants()) do
                if object.Name == "Page" or object.Name == "sectionFrame" or object.Name == "dropFrame" then
                    object.BackgroundColor3 = color
                end
            end
        elseif prope == "Header" then
            MainHeader.BackgroundColor3 = color
            coverup.BackgroundColor3 = color
            MainSide.BackgroundColor3 = color
            coverup_2.BackgroundColor3 = color
        elseif prope == "SchemeColor" then
            tabFrames.ScrollBarImageColor3 = color
            for _, object in ipairs(ScreenGui:GetDescendants()) do
                if object.Name == "sectionHead" then
                    object.BackgroundColor3 = color
                elseif object:IsA("TextButton") and object.Name:match("TabButton$") then
                    object.BackgroundColor3 = color
                elseif object.Name == "Page" and object:IsA("ScrollingFrame") then
                    object.ScrollBarImageColor3 = Color3.new(
                        math.clamp(color.R - 16 / 255, 0, 1),
                        math.clamp(color.G - 15 / 255, 0, 1),
                        math.clamp(color.B - 28 / 255, 0, 1)
                    )
                end
            end
        elseif prope == "TextColor" then
            for _, object in ipairs(ScreenGui:GetDescendants()) do
                if object.Name == "sectionName" then
                    object.TextColor3 = color
                elseif object:IsA("TextButton") and object.Name:match("TabButton$") then
                    object.TextColor3 = color
                end
            end
        end

        applyThemeUpdates()
        return true
    end
