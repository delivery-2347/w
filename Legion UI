                thumbCorner.Parent = thumbCircle

                local currentVal = defaultVal

                local function updateSlider(val)
                    currentVal = math.clamp(val, minVal, maxVal)
                    local percent = (currentVal - minVal) / (maxVal - minVal)
                    fillLine.Size = UDim2.new(percent, 0, 1, 0)
                    valLabel.Text = tostring(math.floor(currentVal))
                    pcall(callback, math.floor(currentVal))
                end

                updateSlider(defaultVal)

                local isSliding = false

                local function slide(inputObj)
                    local trackX = barTrack.AbsolutePosition.X
                    local trackW = barTrack.AbsoluteSize.X
                    local mouseX = inputObj.Position.X
                    local percent = math.clamp((mouseX - trackX) / trackW, 0, 1)
                    local newVal = minVal + (maxVal - minVal) * percent
                    updateSlider(newVal)
                end

                barTrack.InputBegan:Connect(function(inputObj)
                    if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
                        isSliding = true
                        slide(inputObj)
                    end
                end)

                sliderElement.InputBegan:Connect(function(inputObj)
                    if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
                        isSliding = true
                        slide(inputObj)
                    end
                end)

                input.InputEnded:Connect(function(inputObj)
                    if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
                        isSliding = false
                    end
                end)

                input.InputChanged:Connect(function(inputObj)
                    if isSliding and (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
                        slide(inputObj)
                    end
                end)

                allConfigElements[slidName] = {
                    get = function() return currentVal end,
                    set = function(val) updateSlider(val) end
                }

                updateSectionFrame()
            end

