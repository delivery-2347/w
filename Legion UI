local function forceLetterWrap(text)
    if not text then return "" end
    local chars = {}
    for _, code in utf8.codes(text) do
        table.insert(chars, utf8.char(code))
    end
    return table.concat(chars, utf8.char(0x200B))
end

local function formatSliderValue(val)
    local rounded = math.round(val * 1000) / 1000
    return tostring(rounded)
end

local function GetGradientSeq(theme)
    local startC = theme.GradientStart or theme.Accent
    local endC = theme.GradientEnd or theme.Accent
    return ColorSequence.new{
        ColorSequenceKeypoint.new(0, startC), 
        ColorSequenceKeypoint.new(1, endC)
    }
end

local function GetAssetId(id)
    if not id or id == "" then return "" end
    local str = tostring(id)
    if str:find("rbxasset://") or str:find("rbxthumb://") or str:find("rbxassetid://") then return str end
    local num = str:match("%d+")
    if num then return "rbxassetid://" .. num end
    return ""
end

local function SetImageAsync(instance, property, idStr)
    local parsedId = GetAssetId(idStr)
    if parsedId == "" then
        instance[property] = ""
        return
    end
    instance[property] = parsedId
end

local function GetTheme(cfg)
    if type(cfg) == "table" then 
        local mapped = {}
        mapped.Main = cfg.Main or Themes.Default.Main
        mapped.Second = cfg.Second or Themes.Default.Second
        mapped.Accent = cfg.Accent or Themes.Default.Accent
        mapped.ElementAccent = cfg.ElementAccent or mapped.Accent
        mapped.Text = cfg.TextColor or cfg.Text or Themes.Default.Text
        mapped.TextDark = cfg.TextDark or Themes.Default.TextDark
        mapped.Error = cfg.Error or Themes.Default.Error
        mapped.GradientStart = cfg.GradientStart or mapped.Accent
        mapped.GradientEnd = cfg.GradientEnd or mapped.Accent
        mapped.Transparency = cfg.BGTransparency and (cfg.BGTransparency / 100) or cfg.Transparency or 0.05
        mapped.HudTransparency = cfg.HudTransparency and (cfg.HudTransparency / 100) or cfg.HudTransparency or 0.4
        mapped.ImageTransparency = cfg.ImageTransparency and (cfg.ImageTransparency / 100) or cfg.ImageTransparency or 0
        mapped.Background = GetAssetId(cfg.BackgroundID or cfg.Background or "")
        mapped.UiScale = cfg.UiScale or 1.0
        mapped.Font = cfg.Font or "Gotham"
        mapped.CornerRadius = cfg.CornerRadius or 6
        mapped.Gradient = GetGradientSeq(mapped)
        return mapped
    end

    if isfile and isfile(Library.ThemeFolder .. "/" .. tostring(cfg) .. ".json") then
        local content = readfile(Library.ThemeFolder .. "/" .. tostring(cfg) .. ".json")
        local parsed = HS:JSONDecode(content)
        local restored = {}
        for k, v in pairs(parsed) do
            if type(v) == "table" and v.R then
                restored[k] = Color3.new(v.R, v.G, v.B)
            else
                restored[k] = v
            end
        end
        restored.Gradient = GetGradientSeq(restored)
        return restored
    end

    return Themes[cfg] or Themes.Default
end

local function Create(class, properties)
    local instance = Instance.new(class)
    local targetParent = properties.Parent
    properties.Parent = nil

    for k, v in pairs(properties) do
        instance[k] = v
    end

    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        table.insert(Library.TextObjects, instance)
        if not properties.Font then
            instance.Font = Library.GlobalFont
        end
    end

    if targetParent then
        instance.Parent = targetParent
    end

    return instance
end

local function AddCorner(instance, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or Library.GlobalCornerValue)
    corner.Parent = instance
    table.insert(Library.CornerObjects, {Corner = corner, BaseRadius = radius or Library.GlobalCornerValue})
    return corner
end

