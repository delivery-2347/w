                itBtn.MouseButton1Click:Connect(function()
                    titleLbl.Text = dropTitleText .. ": " .. tostring(it)
                    isOp = false
                    Utility:TweenObject(arrow, {Rotation = 180}, 0.2)
                    Utility:TweenObject(frame, {Size = UDim2.new(1, -6, 0, 30)}, 0.2)
                    pcall(onSelected, tostring(it))
                    updateSettingsCanvas()
                end)
            end
            container.Size = UDim2.new(1, -8, 0, listLayout.AbsoluteContentSize.Y)
        end

        header.MouseButton1Click:Connect(function()
            isOp = not isOp
            if isOp then refresh() end
            local targetH = isOp and (36 + listLayout.AbsoluteContentSize.Y) or 30
            Utility:TweenObject(arrow, {Rotation = isOp and 0 or 180}, 0.2)
            local tw = Utility:TweenObject(frame, {Size = UDim2.new(1, -6, 0, targetH)}, 0.2)
            tw.Completed:Connect(updateSettingsCanvas)
        end)

        updateSettingsCanvas()
        return {
            refresh = refresh,
            setTitle = function(t) titleLbl.Text = dropTitleText .. ": " .. tostring(t) end
        }
    end

