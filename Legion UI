                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                ZIndex = 7,
                Parent = Card
            })
            Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = ContentHolder })
            Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = ContentHolder })

            return GetElements(ContentHolder)
        end

        return TabElements
    end

    ----------------------------------------------------------------------
    -- ⚙️ ВСТРОЕННЫЙ ТАБ НАСТРОЕК (UI SETTINGS)
    ----------------------------------------------------------------------
    local SettingsTab = Funcs:CreateTab({
        Name = "UI Settings",
        SubText = "ui & configs",
        ImageID = "rbxassetid://7059346373"
    })

    local AppBlock = SettingsTab:CreateBlock({Name = "Appearance", Side = "Left", ImageID = "rbxassetid://10884488899"})
    AppBlock:CreateDropdown({
        Name = "Font",
        Items = AvailableFonts,
        Default = Library.GlobalFont.Name,
        Callback = function(val) UpdateFonts(val) end
    })
    AppBlock:CreateSlider({
        Name = "UI Scale",
        Min = 0.7,
        Max = 1.5,
        Default = Library.GlobalScale,
        Callback = function(v)
            Library.GlobalScale = v
            WindowScale.Scale = v
        end
    })
    AppBlock:CreateSlider({
        Name = "Bg Transparency",
        Min = 0,
        Max = 100,
        Default = math.floor((SelectedTheme.Transparency or 0.05) * 100),
        Callback = function(v)
            WindowContainer.BackgroundTransparency = v / 100
        end
    })
    AppBlock:CreateInput({
        Name = "Background ID",
        Placeholder = "Image ID...",
        Callback = function(val)
            SetImageAsync(ConstellationBg, "Image", val)
            ConstellationBg.ImageTransparency = 0.2
        end
    })

    local KeyBlock = SettingsTab:CreateBlock({Name = "Keybinds", Side = "Left", ImageID = "rbxassetid://10884491769"})
    KeyBlock:CreateKeybind({
        Name = "Toggle UI",
        Flag = "Settings_ToggleKey",
        Default = Library.ToggleKey,
        Callback = function(key) Library.ToggleKey = key end
    })

    local ConfigBlock = SettingsTab:CreateBlock({Name = "Config Manager", Side = "Right", ImageID = "rbxassetid://10884496263"})
    local ConfigNameInput = "default"
    ConfigBlock:CreateInput({
        Name = "Name",
        Default = "default",
        Callback = function(v) ConfigNameInput = v end
    })
    ConfigBlock:CreateButton({
        Name = "Save Config",
        Callback = function()
            Library:SaveConfig(ConfigNameInput)
            Library:Notify({Title = "Config Saved", Content = "Saved: " .. ConfigNameInput})
        end
    })

    local LoadDrop = ConfigBlock:CreateDropdown({
        Name = "Load",
        Items = Library:GetConfigs(),
        UpdateList = function() return Library:GetConfigs() end,
        Callback = function(cfgName)
            if cfgName and cfgName ~= "none" then
                Library:LoadConfig(cfgName)
                Library:Notify({Title = "Config Loaded", Content = "Loaded: " .. cfgName})
            end
        end
    })

    ConfigBlock:CreateButton({
        Name = "Delete Config",
        Callback = function()
            local selected = LoadDrop:Get()
            if selected and selected ~= "none" then
                Library:DeleteConfig(selected)
                Library:Notify({Title = "Config Deleted", Content = "Deleted: " .. selected})
            end
        end
    })

    return Funcs
end

return Library
