local function UpdateFonts(FontName)
    local NewFont = Enum.Font[FontName] or Enum.Font.Gotham
    Library.GlobalFont = NewFont
    local BoldName = FontName .. "Bold"
    if pcall(function() return Enum.Font[BoldName] end) then
        Library.GlobalFontBold = Enum.Font[BoldName]
    else
        Library.GlobalFontBold = NewFont
    end

    for _, obj in pairs(Library.TextObjects) do
        if obj and obj.Parent then
            local s = tostring(obj.Font)
            if s:find("Bold") then
                obj.Font = Library.GlobalFontBold
            else
                obj.Font = Library.GlobalFont
            end
        end
    end
end

local function MakeDraggable(topbar, frame)
    local dragging, dragInput, dragStart, startPos
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    topbar.InputChanged:Connect(function(input) 
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end 
    end)
    local moveConn = UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            TS:Create(frame, TweenInfo.new(0.06, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}):Play()
        end
    end)
    table.insert(Library.Connections, moveConn)
end

local function GetSafeGuiParent()
    if gethui then return gethui() end
    local success, coreGui = pcall(function() return CG end)
    if success and coreGui then
        local testOk = pcall(function()
            local f = Instance.new("Folder")
            f.Parent = coreGui
            f:Destroy()
        end)
        if testOk then return coreGui end
    end
    return LP:WaitForChild("PlayerGui")
end

function Library:GetConfigs()
    local list = {}
    pcall(function()
        if isfolder and isfolder(Library.ConfigFolder) then
            for _, file in pairs(listfiles(Library.ConfigFolder)) do
                if file:sub(-5) == ".json" then
                    table.insert(list, file:match("([^/]+)%.json$") or file)
                end
            end
        end
    end)
    return list
end

function Library:SaveConfig(Name)
    local ConfigToSave = {}
    for flag, value in pairs(Library.Flags) do
        ConfigToSave[flag] = value
    end
    pcall(function()
        local json = HS:JSONEncode(ConfigToSave)
        writefile(Library.ConfigFolder .. "/" .. Name .. ".json", json)
    end)
end

function Library:LoadConfig(Name)
    local path = Library.ConfigFolder .. "/" .. Name .. ".json"
    pcall(function()
        if isfile and isfile(path) then
            Library.IsLoadingConfig = true
            local json = readfile(path)
            local data = HS:JSONDecode(json)
            for flag, value in pairs(data) do
                if Library.Items[flag] then
                    pcall(function() Library.Items[flag].Set(value) end)
                end
            end
            Library.IsLoadingConfig = false
        end
    end)
end

function Library:DeleteConfig(Name)
    local path = Library.ConfigFolder .. "/" .. Name .. ".json"
    pcall(function()
        if isfile and isfile(path) then delfile(path) end
    end)
end

