    local function ToggleUI()
        if isAnimating then return end
        isAnimating = true

        if IsOpen then
            IsOpen = false
            local scaleTween = TS:Create(WindowScale, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Scale = 0.88})
            local shadowTween = TS:Create(MainShadow, TweenInfo.new(0.18, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {ImageTransparency = 1})
            
            scaleTween:Play()
            shadowTween:Play()
            
            scaleTween.Completed:Connect(function()
                if not IsOpen then WindowContainer.Visible = false end
                isAnimating = false
            end)
        else
            IsOpen = true
            WindowContainer.Visible = true
            WindowScale.Scale = 0.88
            MainShadow.ImageTransparency = 1

            local scaleTween = TS:Create(WindowScale, TweenInfo.new(0.24, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Scale = Library.GlobalScale})
            local shadowTween = TS:Create(MainShadow, TweenInfo.new(0.24, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {ImageTransparency = 0.45})
            
            scaleTween:Play()
            shadowTween:Play()
            
            scaleTween.Completed:Connect(function() isAnimating = false end)
        end
    end

