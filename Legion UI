                barTrack.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
                barTrack.Position = UDim2.new(0, 10, 0, 26)
                barTrack.Size = UDim2.new(1, -20, 0, 6)
                barTrack.AutoButtonColor = false
                barTrack.Text = ""
                barTrack.ZIndex = 4

                trackCorner.CornerRadius = UDim.new(1, 0)
                trackCorner.Parent = barTrack

                -- Цветная линия прогресса (тема)
                fillLine.Name = "fillLine"
                fillLine.Parent = barTrack
                fillLine.BackgroundColor3 = currentTheme.SchemeColor
                fillLine.Size = UDim2.new(0, 0, 1, 0)
                fillLine.BorderSizePixel = 0
                fillLine.ZIndex = 5
                table.insert(ThemeSubscribers.SchemeColor, fillLine)

                fillCorner.CornerRadius = UDim.new(1, 0)
