    if type(selfOrName) == "table" and (selfOrName == Legion or selfOrName.CreateLib) then
        legionName = themeList
        themeList = iconId
        iconId = toggleKey
        toggleKey = rootFolderName
        rootFolderName = "LegionSettings"
    else
        legionName = selfOrName
    end

    rootFolderName = rootFolderName or "LegionSettings"
    legionName = legionName or "Legion"

    pcall(function()
        if makefolder then
            if not isfolder(rootFolderName) then makefolder(rootFolderName) end
            if not isfolder(rootFolderName .. "/Config") then makefolder(rootFolderName .. "/Config") end
            if not isfolder(rootFolderName .. "/Theme") then makefolder(rootFolderName .. "/Theme") end
