                local dropCorner = Instance.new("UICorner")
                local dropHeader = Instance.new("TextButton")
                local dropTitle = Instance.new("TextLabel")
                local arrowIcon = Instance.new("ImageLabel")
                local optionContainer = Instance.new("Frame")
                local optionListing = Instance.new("UIListLayout")

                dropFrame.Name = "dropFrame"
                dropFrame.Parent = sectionInners
                dropFrame.BackgroundColor3 = currentTheme.ElementColor
                dropFrame.Size = UDim2.new(1, 0, 0, 33)
                dropFrame.ClipsDescendants = true
                dropFrame.ZIndex = 3
                table.insert(ThemeSubscribers.ElementColor, dropFrame)

                dropCorner.CornerRadius = UDim.new(0, 4)
                dropCorner.Parent = dropFrame

                dropHeader.Name = "dropHeader"
                dropHeader.Parent = dropFrame
                dropHeader.BackgroundTransparency = 1.000
                dropHeader.Size = UDim2.new(1, 0, 0, 33)
                dropHeader.AutoButtonColor = false
                dropHeader.Text = ""
                dropHeader.ZIndex = 3

                local function getDisplayText()
                    if #selectedList == 0 then
                        return dropName .. " (None)"
                    elseif #selectedList == 1 then
                        return selectedList[1]
                    else
                        return table.concat(selectedList, ", ")
                    end
                end

                dropTitle.Name = "dropTitle"
                dropTitle.Parent = dropHeader
                dropTitle.BackgroundTransparency = 1.000
                dropTitle.Position = UDim2.new(0, 10, 0, 0)
                dropTitle.Size = UDim2.new(1, -45, 1, 0)
                dropTitle.Font = currentFont
                dropTitle.Text = getDisplayText()
                dropTitle.TextColor3 = currentTheme.TextColor
                dropTitle.TextSize = 14.000
                dropTitle.TextXAlignment = Enum.TextXAlignment.Left
                dropTitle.ZIndex = 4
                table.insert(FontLabels, dropTitle)
                table.insert(ThemeSubscribers.TextColor, dropTitle)

                arrowIcon.Name = "arrowIcon"
                arrowIcon.Parent = dropHeader
                arrowIcon.BackgroundTransparency = 1.000
                arrowIcon.AnchorPoint = Vector2.new(1, 0.5)
                arrowIcon.Position = UDim2.new(1, -10, 0.5, 0)
                arrowIcon.Size = UDim2.new(0, 18, 0, 18)
                arrowIcon.Image = "rbxassetid://3926305904"
                arrowIcon.ImageRectOffset = Vector2.new(644, 364)
                arrowIcon.ImageRectSize = Vector2.new(36, 36)
                arrowIcon.ImageColor3 = currentTheme.SchemeColor
                arrowIcon.Rotation = 180
                arrowIcon.ZIndex = 4
                table.insert(ThemeSubscribers.SchemeColor, arrowIcon)

                optionContainer.Name = "optionContainer"
                optionContainer.Parent = dropFrame
                optionContainer.BackgroundTransparency = 1.000
                optionContainer.Position = UDim2.new(0, 5, 0, 35)
                optionContainer.Size = UDim2.new(1, -10, 0, 0)
                optionContainer.ZIndex = 3

                optionListing.Name = "optionListing"
                optionListing.Parent = optionContainer
                optionListing.SortOrder = Enum.SortOrder.LayoutOrder
                optionListing.Padding = UDim.new(0, 3)

                dropFrame:GetPropertyChangedSignal("Size"):Connect(function()
                    updateSectionFrame()
                end)

                local function getTargetHeight()
                    return 38 + optionListing.AbsoluteContentSize.Y
                end

                local function toggleDropdown()
                    isOpened = not isOpened
                    local targetSize = isOpened and UDim2.new(1, 0, 0, getTargetHeight()) or UDim2.new(1, 0, 0, 33)
                    local targetRotation = isOpened and 0 or 180

                    Utility:TweenObject(arrowIcon, {Rotation = targetRotation}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    Utility:TweenObject(dropFrame, {Size = targetSize}, 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                end

                dropHeader.MouseButton1Click:Connect(toggleDropdown)

                local function renderOptions(itemList)
                    for _, child in pairs(optionContainer:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end

                    for _, item in pairs(itemList) do
                        local itemStr = tostring(item)
                        local optBtn = Instance.new("TextButton")
                        local optCorner = Instance.new("UICorner")
                        local checkIndicator = Instance.new("Frame")
                        local checkCorner = Instance.new("UICorner")

                        local isSelected = table.find(selectedList, itemStr) ~= nil

                        optBtn.Name = "Option_" .. itemStr
                        optBtn.Parent = optionContainer
                        optBtn.BackgroundColor3 = isSelected and currentTheme.SchemeColor or Color3.fromRGB(28, 28, 32)
                        optBtn.BackgroundTransparency = isSelected and 0.35 or 0 -- Четкая подсветка выбранного
                        optBtn.Size = UDim2.new(1, 0, 0, 26)
                        optBtn.AutoButtonColor = false
                        optBtn.Font = currentFont
                        optBtn.Text = "  " .. itemStr
                        optBtn.TextColor3 = isSelected and Color3.fromRGB(255, 255, 255) or currentTheme.TextColor
                        optBtn.TextSize = 13.000
                        optBtn.TextXAlignment = Enum.TextXAlignment.Left
                        optBtn.ZIndex = 4
                        table.insert(FontLabels, optBtn)

                        optCorner.CornerRadius = UDim.new(0, 4)
                        optCorner.Parent = optBtn

                        checkIndicator.Name = "checkIndicator"
                        checkIndicator.Parent = optBtn
                        checkIndicator.AnchorPoint = Vector2.new(1, 0.5)
                        checkIndicator.Position = UDim2.new(1, -8, 0.5, 0)
                        checkIndicator.Size = UDim2.new(0, 10, 0, 10)
                        checkIndicator.BackgroundColor3 = isSelected and currentTheme.SchemeColor or Color3.fromRGB(50, 50, 55)
                        checkIndicator.ZIndex = 5

                        checkCorner.CornerRadius = UDim.new(1, 0)
                        checkCorner.Parent = checkIndicator

                        optBtn.MouseButton1Click:Connect(function()
                            if isMulti then
                                local foundIndex = table.find(selectedList, itemStr)
                                if foundIndex then
                                    table.remove(selectedList, foundIndex)
                                else
                                    table.insert(selectedList, itemStr)
                                end
                                dropTitle.Text = getDisplayText()
                                renderOptions(itemList)
                                pcall(callback, selectedList)
                            else
                                selectedList = {itemStr}
                                dropTitle.Text = itemStr
                                toggleDropdown()
                                renderOptions(itemList)
                                pcall(callback, itemStr)
                            end
                        end)
                    end

                    optionContainer.Size = UDim2.new(1, -10, 0, optionListing.AbsoluteContentSize.Y)
                end

                renderOptions(list)

                function DropHandler:Set(newVal)
                    if type(newVal) == "table" then
                        selectedList = {}
                        for _, v in pairs(newVal) do table.insert(selectedList, tostring(v)) end
                    else
                        selectedList = {tostring(newVal)}
                    end
                    dropTitle.Text = getDisplayText()
                    renderOptions(list)
                    pcall(callback, isMulti and selectedList or selectedList[1])
                end

                function DropHandler:Get()
                    return isMulti and selectedList or selectedList[1]
                end

                function DropHandler:Refresh(newList)
                    list = newList or {}
                    renderOptions(list)
                    if isOpened then
                        dropFrame.Size = UDim2.new(1, 0, 0, getTargetHeight())
                    end
                end

                allConfigElements[dropName] = {
                    get = function() return DropHandler:Get() end,
                    set = function(val) DropHandler:Set(val) end
                }

                updateSectionFrame()
                return DropHandler
            end

            return Elements
        end

        Sections.CreateSection = Sections.NewSection
        return Sections
    end

    function Tabs:SetToggleKey(newKeyCode)
        if typeof(newKeyCode) == "EnumItem" then
            currentToggleKey = newKeyCode
        elseif type(newKeyCode) == "string" and Enum.KeyCode[newKeyCode] then
            currentToggleKey = Enum.KeyCode[newKeyCode]
        end
    end

    function Tabs:Toggle()
        toggleUIAnimation()
    end

    function Tabs:Destroy()
        terminateEntireLibrary()
    end

    Tabs.NewTab = Tabs.CreateTab
    return Tabs
end

Legion.CreateWindow = Legion.CreateLib

return Legion
