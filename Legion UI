local function getGuiParent()
    local s1, h = pcall(function() return gethui and gethui() end)
    if s1 and h then return h end

    local s2, c = pcall(function() return game:GetService("CoreGui") end)
    if s2 and c then return c end

    local s3, p = pcall(function() return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui") end)
    if s3 and p then return p end

    return nil
end

local Utility = {}
function Utility:TweenObject(obj, properties, duration, ...)
    local t = tween:Create(obj, tweeninfo(duration, ...), properties)
    t:Play()
    return t
end

