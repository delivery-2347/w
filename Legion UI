    local function toggleUIAnimation()
        if isAnimating then return end
        isAnimating = true

        if isGuiVisible then
            lastSavedPos = Main.Position
            lastSavedSize = Main.Size
            isGuiVisible = false

            local stretchedWidth = math.clamp(lastSavedSize.X.Offset * 1.25, 550, 900)
            local targetPos = UDim2.new(0.5, -stretchedWidth / 2, 1.35, 0)
            local targetSize = UDim2.new(0, stretchedWidth, 0, math.max(lastSavedSize.Y.Offset * 0.75, 200))

            local closeTween = tween:Create(Main, tweeninfo(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Position = targetPos,
                Size = targetSize
            })
            closeTween:Play()
            closeTween.Completed:Connect(function()
                if not isGuiVisible then
                    Main.Visible = false
                end
                isAnimating = false
            end)
        else
            isGuiVisible = true
            Main.Visible = true

            local stretchedWidth = math.clamp(lastSavedSize.X.Offset * 1.25, 550, 900)
            Main.Position = UDim2.new(0.5, -stretchedWidth / 2, 1.35, 0)
            Main.Size = UDim2.new(0, stretchedWidth, 0, math.max(lastSavedSize.Y.Offset * 0.75, 200))

            local openTween = tween:Create(Main, tweeninfo(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Position = lastSavedPos,
                Size = lastSavedSize
            })
            openTween:Play()
            openTween.Completed:Connect(function()
                isAnimating = false
            end)
        end
    end

