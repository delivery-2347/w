                -- Кругляшок на конце линии
                thumbCircle.Name = "thumbCircle"
                thumbCircle.Parent = fillLine
                thumbCircle.AnchorPoint = Vector2.new(0.5, 0.5)
                thumbCircle.Position = UDim2.new(1, 0, 0.5, 0)
                thumbCircle.Size = UDim2.new(0, 12, 0, 12)
                thumbCircle.BackgroundColor3 = currentTheme.SchemeColor
                thumbCircle.BorderSizePixel = 0
                thumbCircle.ZIndex = 6
                table.insert(ThemeSubscribers.SchemeColor, thumbCircle)

