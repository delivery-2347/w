        TextColor3 = SelectedTheme.TextDark,
        TextSize = 13,
        Parent = KeyContainer
    })
    AddCorner(GetKeyBtn, 6)
    AddStroke(GetKeyBtn, SelectedTheme.Accent, 0.8)
    CreateRipple(GetKeyBtn, SelectedTheme.Accent)

    local Status = Create("TextLabel", {
        Size = UDim2.new(1, 0, 0, 24),
        Position = UDim2.new(0, 0, 1, -34),
        BackgroundTransparency = 1,
        Text = "Protected System",
        Font = Library.GlobalFont,
        TextColor3 = SelectedTheme.TextDark,
        TextSize = 12,
        Parent = KeyContainer
    })

    GetKeyBtn.MouseButton1Click:Connect(function()
        pcall(function()
            if setclipboard then setclipboard(LinkToCopy)
            elseif toclipboard then toclipboard(LinkToCopy) end
        end)
        Status.Text = "Link copied to clipboard!"
        Status.TextColor3 = SelectedTheme.Accent
        task.wait(2)
        Status.Text = "Protected System"
        Status.TextColor3 = SelectedTheme.TextDark
    end)

    VerifyBtn.MouseButton1Click:Connect(function()
        if InputBox.Text == Key then
            Status.Text = "Key Verified!"
            Status.TextColor3 = Color3.fromRGB(80, 255, 120)
            TS:Create(KeyContainer, TweenInfo.new(0.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Size = UDim2.fromOffset(0, 0)}):Play()
