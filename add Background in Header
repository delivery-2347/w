                    if keyInput.KeyCode.Name ~= "Unknown" then
                        togName_2.Text = keyInput.KeyCode.Name
                        oldKey = keyInput.KeyCode.Name
                    end
                end)

                input.InputBegan:Connect(function(current, gameProcessed)
                    if not gameProcessed and current.KeyCode.Name == oldKey then
                        task.spawn(callback)
